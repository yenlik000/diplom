# ── Database ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bridge_lms
DB_USER=postgres
DB_PASSWORD=secret

# ── JWT — generate with: openssl rand -hex 64 ──────────────────
JWT_SECRET=change_me_to_a_strong_random_string_at_least_64_chars

# ── CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
