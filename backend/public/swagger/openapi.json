    "/reviews/{id}/vote": {
      "patch": {
        "tags": ["Reviews"],
        "summary": "Vote on a review (like / dislike / undo)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 4 }, "description": "Review ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["dir"],
                "properties": {
                  "dir":      { "type": "string", "enum": ["like", "dislike", "none"], "example": "like", "description": "Vote direction; 'none' removes previous vote" },
                  "prev_dir": { "type": "string", "enum": ["like", "dislike", "none"], "example": "none", "description": "Client's previously stored vote to undo" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated review with new like/dislike counts",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Review" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },

