    "/homeworks/{id}/submit": {
      "post": {
        "tags": ["Homework"],
        "summary": "Submit homework answers",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 2 }, "description": "Homework ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["answers"],
                "properties": {
                  "answers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "question_id":        { "type": "integer", "example": 1 },
                        "selected_option_id": { "type": "integer", "nullable": true, "example": 3 },
                        "answer_text":        { "type": "string", "nullable": true, "example": null }
                      }
                    },
                    "example": [
                      { "question_id": 1, "selected_option_id": 3, "answer_text": null },
                      { "question_id": 2, "selected_option_id": null, "answer_text": "The water cycle involves evaporation..." }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Submission created with score",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "submission_id": { "type": "integer", "example": 15 },
                    "score":         { "type": "number", "example": 80.0 }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

