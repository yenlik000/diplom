{
  "openapi": "3.0.3",
  "info": {
    "title": "Bridge LMS API",
    "version": "1.0.0",
    "description": "REST API for the Bridge LMS educational platform. JWT Bearer token required for protected endpoints."
  },
  "servers": [
    { "url": "http://localhost:8000", "description": "Local PHP dev server" },
    { "url": "http://localhost/lms-diplom/backend/public", "description": "Local Apache/Nginx" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id":         { "type": "integer", "example": 1 },
          "email":      { "type": "string", "format": "email", "example": "student@bridge.kz" },
          "name":       { "type": "string", "example": "Aizat Nurlanovna" },
          "avatar_url": { "type": "string", "nullable": true, "example": null },
          "role":       { "type": "string", "enum": ["student", "teacher", "admin"], "example": "student" },
          "created_at": { "type": "string", "format": "date-time", "example": "2025-01-15T10:30:00Z" }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id":           { "type": "integer", "example": 3 },
          "title":        { "type": "string", "example": "IELTS Preparation" },
          "description":  { "type": "string", "nullable": true, "example": "Complete IELTS prep from band 5 to 7+" },
          "cover_image":  { "type": "string", "nullable": true, "example": "https://cdn.bridge.kz/covers/ielts.jpg" },
          "price":        { "type": "number", "format": "float", "example": 49990 },
          "level":        { "type": "string", "nullable": true, "example": "B2" },
          "subject":      { "type": "string", "nullable": true, "example": "IELTS" },
          "is_published": { "type": "boolean", "example": true },
          "created_at":   { "type": "string", "format": "date-time", "example": "2025-01-10T08:00:00Z" }
        }
      },
      "Module": {
        "type": "object",
        "properties": {
          "id":        { "type": "integer", "example": 5 },
          "course_id": { "type": "integer", "example": 3 },
          "title":     { "type": "string", "example": "Reading Skills" },
          "order_num": { "type": "integer", "example": 1 }
        }
      },
      "Lesson": {
        "type": "object",
        "properties": {
          "id":              { "type": "integer", "example": 12 },
          "module_id":       { "type": "integer", "example": 5 },
          "title":           { "type": "string", "example": "Skimming and Scanning" },
          "video_url":       { "type": "string", "nullable": true, "example": "https://cdn.bridge.kz/videos/lesson12.mp4" },
          "text_content":    { "type": "string", "nullable": true, "example": "In this lesson we cover..." },
          "order_num":       { "type": "integer", "example": 2 },
          "is_free_preview": { "type": "boolean", "example": false }
        }
      },
      "Enrollment": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer", "example": 7 },
          "user_id":     { "type": "integer", "example": 1 },
          "course_id":   { "type": "integer", "example": 3 },
          "enrolled_at": { "type": "string", "format": "date-time", "example": "2025-02-01T12:00:00Z" },
          "expires_at":  { "type": "string", "format": "date-time", "nullable": true, "example": null }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "id":         { "type": "integer", "example": 4 },
          "author":     { "type": "string", "example": "Damir Bekzhanov" },
          "title":      { "type": "string", "example": "Great platform!" },
          "body":       { "type": "string", "example": "The courses are well structured and easy to follow." },
          "rating":     { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
          "likes":      { "type": "integer", "example": 12 },
          "dislikes":   { "type": "integer", "example": 1 },
          "created_at": { "type": "string", "format": "date-time", "example": "2025-03-20T09:15:00Z" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer", "example": 9 },
          "user_id":     { "type": "integer", "example": 1 },
          "author_name": { "type": "string", "example": "Aizat Nurlanovna" },
          "body":        { "type": "string", "example": "Really helpful content, thanks!" },
          "created_at":  { "type": "string", "format": "date-time", "example": "2025-04-05T14:20:00Z" }
        }
      },
      "Homework": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer", "example": 2 },
          "lesson_id":   { "type": "integer", "example": 12 },
          "title":       { "type": "string", "nullable": true, "example": "Reading Practice Test" },
          "description": { "type": "string", "nullable": true, "example": "Answer all questions based on the passage." },
          "questions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HomeworkQuestion" }
          }
        }
      },
      "HomeworkQuestion": {
        "type": "object",
        "properties": {
          "id":            { "type": "integer", "example": 1 },
          "question_text": { "type": "string", "example": "What is the main idea of the passage?" },
          "question_type": { "type": "string", "enum": ["multiple_choice", "open"], "example": "multiple_choice" },
          "order_num":     { "type": "integer", "example": 1 },
          "options": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HomeworkOption" }
          }
        }
      },
      "HomeworkOption": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer", "example": 3 },
          "option_text": { "type": "string", "example": "Climate change effects on agriculture" },
          "is_correct":  { "type": "boolean", "example": true }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id":         { "type": "integer", "example": 2 },
          "name":       { "type": "string", "example": "IELTS Group A" },
          "created_at": { "type": "string", "format": "date-time", "example": "2025-01-20T10:00:00Z" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error":   { "type": "string", "example": "Unauthorized" },
          "message": { "type": "string", "example": "Invalid or expired token." }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid JWT token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Insufficient role permissions",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  },
  "paths": {

    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login with email + password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email":    { "type": "string", "format": "email", "example": "admin@bridge.kz" },
                  "password": { "type": "string", "example": "secret123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token and user object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..." },
                    "user":  { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["full_name", "email", "password"],
                "properties": {
                  "full_name": { "type": "string", "example": "Aizat Nurlanovna" },
                  "email":     { "type": "string", "format": "email", "example": "aizat@example.com" },
                  "password":  { "type": "string", "minLength": 6, "example": "pass1234" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration successful, returns token + user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..." },
                    "user":  { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },

    "/auth/google": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign in with Google OAuth",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["credential"],
                "properties": {
                  "credential": { "type": "string", "description": "Google ID token", "example": "eyJhbGciOiJSUzI1NiIsImtpZCI6..." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token and user object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..." },
                    "user":  { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/auth/facebook": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign in with Facebook OAuth",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["access_token", "user_id"],
                "properties": {
                  "access_token": { "type": "string", "example": "EAABwzLixnjYBO2ZA..." },
                  "user_id":      { "type": "string", "example": "123456789012345" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token and user object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..." },
                    "user":  { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/users/create": {
      "post": {
        "tags": ["Users (Admin)"],
        "summary": "Create a new user",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["full_name", "email", "password", "role"],
                "properties": {
                  "full_name": { "type": "string", "example": "Bekzat Omirov" },
                  "email":     { "type": "string", "format": "email", "example": "bekzat@bridge.kz" },
                  "password":  { "type": "string", "example": "tempPass99" },
                  "role":      { "type": "string", "enum": ["student", "teacher", "admin"], "example": "teacher" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },

    "/groups": {
      "get": {
        "tags": ["Groups (Admin)"],
        "summary": "List all groups",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Array of groups",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Group" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Groups (Admin)"],
        "summary": "Create a group",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "IELTS Group A" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Group created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Group" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },

    "/groups/{id}": {
      "put": {
        "tags": ["Groups (Admin)"],
        "summary": "Update a group",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 2 }, "description": "Group ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "IELTS Group B" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Group updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Group" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Groups (Admin)"],
        "summary": "Delete a group",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 2 }, "description": "Group ID" }
        ],
        "responses": {
          "204": { "description": "Group deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },

    "/courses": {
      "get": {
        "tags": ["Courses"],
        "summary": "List published courses",
        "responses": {
          "200": {
            "description": "Array of courses",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Course" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Courses"],
        "summary": "Create a course (teacher/admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title":        { "type": "string", "example": "SAT Math Prep" },
                  "description":  { "type": "string", "example": "Intensive SAT math preparation." },
                  "cover_image":  { "type": "string", "example": "https://cdn.bridge.kz/covers/sat.jpg" },
                  "price":        { "type": "number", "example": 35000 },
                  "level":        { "type": "string", "example": "Grade 11" },
                  "subject":      { "type": "string", "example": "SAT" },
                  "is_published": { "type": "boolean", "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Course" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },

    "/courses/{id}": {
      "get": {
        "tags": ["Courses"],
        "summary": "Get a course with modules and lessons",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 3 }, "description": "Course ID" }
        ],
        "responses": {
          "200": {
            "description": "Course detail with nested modules/lessons",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Course" },
                    {
                      "type": "object",
                      "properties": {
                        "modules": {
                          "type": "array",
                          "items": {
                            "allOf": [
                              { "$ref": "#/components/schemas/Module" },
                              {
                                "type": "object",
                                "properties": {
                                  "lessons": {
                                    "type": "array",
                                    "items": { "$ref": "#/components/schemas/Lesson" }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Courses"],
        "summary": "Update a course (teacher/admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 3 }, "description": "Course ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title":        { "type": "string", "example": "IELTS Preparation (Updated)" },
                  "description":  { "type": "string", "example": "Updated course description." },
                  "cover_image":  { "type": "string", "example": "https://cdn.bridge.kz/covers/ielts-v2.jpg" },
                  "price":        { "type": "number", "example": 54990 },
                  "level":        { "type": "string", "example": "C1" },
                  "subject":      { "type": "string", "example": "IELTS" },
                  "is_published": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Course updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Course" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Courses"],
        "summary": "Delete a course (teacher/admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 3 }, "description": "Course ID" }
        ],
        "responses": {
          "204": { "description": "Course deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },

    "/courses/{courseId}/modules": {
      "post": {
        "tags": ["Modules"],
        "summary": "Add a module to a course (teacher/admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "courseId", "in": "path", "required": true, "schema": { "type": "integer", "example": 3 }, "description": "Course ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "order_num"],
                "properties": {
                  "title":     { "type": "string", "example": "Writing Skills" },
                  "order_num": { "type": "integer", "example": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Module created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Module" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },

    "/modules/{id}": {
      "put": {
        "tags": ["Modules"],
        "summary": "Update a module (teacher/admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 5 }, "description": "Module ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title":     { "type": "string", "example": "Advanced Reading" },
                  "order_num": { "type": "integer", "example": 3 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Module updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Module" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Modules"],
        "summary": "Delete a module (teacher/admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 5 }, "description": "Module ID" }
        ],
        "responses": {
          "204": { "description": "Module deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
